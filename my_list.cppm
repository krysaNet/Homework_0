module;

#include <iostream>
#include <memory>
#include <stdexcept>

export module my_list;

template<typename T>
    struct Node {
    T data;
    std::unique_ptr<Node<T>> next;
    Node<T>* prev;

    Node(auto val, std::unique_ptr<Node<T>> next = nullptr, Node<T>* prev = nullptr) :
        data(std::move(val)), next(std::move(next)), prev(prev) {}
};

export template<typename T>
class List {
    std::unique_ptr<Node<T>> head = nullptr;
    Node<T>* tail = nullptr;
    std::size_t len = 0uz;

public:
    void push_back(T val) {
        auto x = std::make_unique<Node<T>>(std::move(val), nullptr, tail);
        Node<T>* raw = x.get();
        if (tail) {
            tail -> next = std::move(x);
        } else {
            head = std::move(x);
        }
        tail = raw;
        ++len;
    }

    void push_front(T val) {
        auto x = std::make_unique<Node<T>>(std::move(val), std::move(head), nullptr);
        Node<T>* raw = x.get();

        if (raw -> next) {
            raw -> next -> prev = raw;
        }
        else {
            tail = raw;
        }

        head = std::move(x);
        ++len;
    }

    void clear() noexcept {
        len = 0uz;
        tail = nullptr;

        while (head) { // to avoid recursion
            head = std::move(head -> next);
        }
    }

    void pop_back() {
        if (tail == nullptr) {
            throw std::out_of_range("List is empty: cannot delete element");
        }
        if (tail -> prev == nullptr) {
            clear();
            return;
        }
        tail = tail -> prev;
        tail -> next = nullptr;
        --len;
    }

    void pop_front() {
        if (!head) {
            throw std::out_of_range("List is empty: cannot delete element");
        }
        if (!head -> next) {
            clear();
            return;
        }
        head = std::move(head -> next);
        head -> prev = nullptr;
        --len;
    }

    class iterator {
        Node<T>* current;
        List<T>& list;

    public:
        explicit iterator(List<T>& l) noexcept : current(nullptr), list(l) {}
        explicit iterator(Node<T>* curr, List<T>& l) noexcept : current(curr), list(l) {}

        const auto& get_list() const noexcept {
            return list;
        }

        bool operator == (const iterator& it) const noexcept {
            return current == it.current;
        }
        // operator != was generated by compiler

        auto erase() {
            if (!current) {
                throw std::out_of_range("Cannot dereference or erase end iterator");
            }
            if (current -> prev == nullptr) list.pop_front();
            else if (current->next.get() == nullptr) list.pop_back();
            else {
                current -> next -> prev = current -> prev;
                current -> prev -> next = std::move(current -> next);
                --list.len;
            }
            current = nullptr;
        }

        auto& operator * () {
            if (!current) {
                throw std::out_of_range("Cannot dereference or erase end iterator");
            }
            return current -> data;
        }

        auto operator ++ () {
            if (!current) {
                throw std::out_of_range("Cannot increment or erase end iterator");
            }
            current = current -> next.get();
            return *this;
        }

        auto operator -- () {
            if (!current) {
                if (!list.tail) throw std::out_of_range("Cannot decrement end iterator of an empty list");
                current = list.tail;
            }
            else {
                if (!current->prev) {
                    throw std::out_of_range("Cannot decrement the beginning iterator");
                }
                else current = current -> prev;
            }
            return *this;
        }

        void push_after_this(T val) {
            if (current == nullptr) {
                throw std::invalid_argument("Cannot insert after end iterator");
            }

            auto nd = std::make_unique<Node<T>>
                (std::move(val),std::move(current -> next), current);

            if (nd -> next) {
                nd -> next -> prev = nd.get();
            } else {
                list.tail = nd.get();
            }
            current -> next = std::move(nd);
            ++list.len;
        }
    };

    auto begin() noexcept {
        if (empty()) return iterator(*this);
        iterator it(head.get(), *this);
        return it;
    }
    auto end() noexcept {
        return iterator(*this);
    }
    auto last() {
        if (!tail) {
            throw std::out_of_range("List is empty: tail does not exist");
        }
        return iterator(tail, *this);
    }

    auto it(const std::size_t idx) {
        if (idx >= len) return end();

        if (idx <= len / 2) {
            iterator res(head.get(), *this);
            for (std::size_t i = 0; i < idx; ++i) ++res;
            return res;
        }

        iterator res(tail, *this);
        for (std::size_t i = len - 1; i > idx; --i) --res;
        return res;
    }

    void erase(iterator& it) {
        if (&it.get_list() != this) {
            throw std::invalid_argument("Iterator belongs to another list");
        }
        it.erase();
    }
    void erase(const std::size_t idx) {
        if (idx >= len) {
            throw std::out_of_range("Index out of range");
        }
        auto i = it(idx);
        erase(i);
    }

    void insert_before(T val, iterator it) {
        if (&it.get_list() != this) {
            throw std::invalid_argument("Iterator belongs to another list");
        }
        if (it == end()) {
            push_back(std::move(val));
        }
        else if (it == begin()) {
            push_front(std::move(val));
        }
        else {
            --it;
            it.push_after_this(std::move(val));
        }
    }
    void insert_before(T val, const std::size_t idx) {
        if (idx > len) {
            throw std::out_of_range("Index out of range");
        }
        insert_before(std::move(val), it(idx));
    }

    auto size() const noexcept {
        return len;
    }
    auto empty() const noexcept {
        return len == 0uz;
    }



    ~List() noexcept {
        clear();
    }
};